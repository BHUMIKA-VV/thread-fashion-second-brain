# Copy to .env and adjust. Never commit .env.
# All values below are local-development placeholders, not real credentials.

# --- App ---
# Backend settings use the THREAD_ prefix so machine-wide variables from other
# projects (e.g. a global DATABASE_URL) can never change Thread's configuration.
THREAD_APP_ENV=development
THREAD_LOG_LEVEL=INFO

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=thread
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=thread
POSTGRES_PORT=5434

# --- Backend database connections (must match the values above) ---
THREAD_DATABASE_URL=postgresql+psycopg://thread:change-me-local-only@127.0.0.1:5434/thread
THREAD_TEST_DATABASE_URL=postgresql+psycopg://thread:change-me-local-only@127.0.0.1:5434/thread_test

# --- Frontend -> backend proxy (server-side only; the browser calls /api/*) ---
THREAD_API_URL=http://127.0.0.1:8010

# --- Uploads (optional; defaults shown) ---
# Relative paths resolve against the repo root. Never point this inside frontend/public.
# THREAD_STORAGE_DIR=storage
# THREAD_MAX_UPLOAD_BYTES=15728640
# THREAD_MAX_IMAGE_SIDE=8000
# THREAD_MIN_IMAGE_SIDE=64
# THREAD_MAX_IMAGE_PIXELS=40000000
# THREAD_THUMBNAIL_SIDE=640

# --- Colour palettes (optional; default shown) ---
# THREAD_PALETTE_SIZE=6

# --- Visual similarity (optional; defaults shown) ---
# Weights are fetched once with `python -m scripts.fetch_model`; the API never downloads.
# THREAD_MODEL_CACHE_DIR=.cache/models
# THREAD_EMBEDDINGS_ENABLED=true
# THREAD_EMBEDDING_WARMUP=true

# --- Deep analysis (optional; Milestone 7b) ---
# Leave the key empty to keep deep analysis off: no client is built and nothing is sent.
# With a key, each run sends ONE image (and its palette names and visible tags) to Anthropic
# after you confirm it in the UI, and may be charged. Only these THREAD_ settings are used;
# machine-wide ANTHROPIC_* variables, CLI login profiles and system proxies are ignored.
THREAD_ANTHROPIC_API_KEY=
# THREAD_ANTHROPIC_BASE_URL=https://api.anthropic.com
# THREAD_DEEP_ANALYSIS_MODEL=claude-opus-5-5
# THREAD_DEEP_ANALYSIS_EFFORT=medium
# A guard against runaway use (per user, per UTC day), not a spending limit:
# THREAD_DEEP_ANALYSIS_DAILY_LIMIT=25
# THREAD_DEEP_ANALYSIS_TIMEOUT_SECONDS=120
# "fake" = a local stand-in for development and tests (sends nothing; refused in production):
# THREAD_DEEP_ANALYSIS_PROVIDER=claude

# --- Accounts (Milestone 9a; defaults shown) ---
# Development only: a request without a session acts as the local development user.
# Set false to try the real sign-up and sign-in flow locally.
# THREAD_DEV_AUTO_SIGNIN=true
# THREAD_SIGNUP_ENABLED=true
# THREAD_SESSION_DAYS=30
# Must be true in production (HTTPS only):
# THREAD_COOKIE_SECURE=false
# Browser origins allowed to make changes (comma-separated); https only in production:
# THREAD_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100,http://127.0.0.1:3101
# Base URL used in links inside emails:
# THREAD_PUBLIC_URL=http://127.0.0.1:3100
# How many of your own proxies to trust in X-Forwarded-For (0 = use the socket address):
# THREAD_FORWARDED_HOPS=0
# THREAD_SIGNUP_LIMIT_PER_HOUR=5
# THREAD_LOGIN_LIMIT_PER_15_MINUTES=10
# THREAD_EMAIL_LIMIT_PER_HOUR=3
# Per-account quota (the owner is exempt):
# THREAD_QUOTA_ITEMS=200
# THREAD_QUOTA_BYTES=1073741824
# Email: "log" keeps messages in a local outbox (GET /api/dev/outbox?to=...); "resend" sends.
# THREAD_MAIL_PROVIDER=log
THREAD_RESEND_API_KEY=
# THREAD_EMAIL_FROM=Thread <no-reply@thread.local>
# Shown on /terms and /privacy (read by the frontend at build time):
# THREAD_CONTACT_EMAIL=
